datasource db {
  provider = "postgresql"
}

model action_set_events {
  id            Int      @id @default(autoincrement())
  action_set_id Int
  signal_id     Int
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  state         String
  signal        Json
  action_set    Json

  @@index([action_set_id, state], map: "idx_action_set_events_action_set_id_state")
  @@index([signal_id], map: "idx_action_set_events_signal_id")
}

model action_sets {
  id                 Int       @id @default(autoincrement())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_by_user_id Int?
  name               String?   @db.VarChar(255)
  project            String    @db.VarChar(255)
  actor_id           Int?
  source             String?   @db.VarChar(255)
  source_id          Int?
  payload            Json      @default("{}")
  enabled            Boolean?  @default(true)
  description        String?
  projects           projects  @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actions            actions[]

  @@index([project], map: "idx_action_sets_project")
}

model actions {
  id                 Int          @id @default(autoincrement())
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  created_by_user_id Int?
  action_set_id      Int?
  sort_order         Int?
  action             String       @db.VarChar(255)
  execution_params   Json         @default("{}")
  action_sets        action_sets? @relation(fields: [action_set_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model addons {
  id                           Int                            @id @default(autoincrement())
  provider                     String
  description                  String?
  enabled                      Boolean?                       @default(true)
  parameters                   Json?                          @db.Json
  events                       Json?                          @db.Json
  created_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
  projects                     Json?                          @default("[]")
  environments                 Json?                          @default("[]")
  integration_events           integration_events[]
  servicenow_change_references servicenow_change_references[]
}

model api_token_project {
  secret     String
  project    String
  projects   projects   @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)
  api_tokens api_tokens @relation(fields: [secret], references: [secret], onDelete: Cascade, onUpdate: NoAction)

  @@id([secret, project])
}

model api_tokens {
  secret             String              @id
  username           String
  type               String
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  expires_at         DateTime?           @db.Timestamptz(6)
  seen_at            DateTime?           @db.Timestamptz(6)
  environment        String?             @db.VarChar
  alias              String?
  token_name         String?
  created_by_user_id Int?
  api_token_project  api_token_project[]
  edge_api_tokens    edge_api_tokens[]
}

model api_tokens_v2 {
  selector              String                  @id
  verifier              String
  token_name            String
  type                  String
  environment           String
  expires_at            DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  seen_at               DateTime?               @db.Timestamptz(6)
  user_created          Boolean                 @default(true)
  environments          environments            @relation(fields: [environment], references: [name], onDelete: NoAction, onUpdate: NoAction)
  api_tokens_v2_project api_tokens_v2_project[]
}

model api_tokens_v2_project {
  selector      String
  project       String
  projects      projects      @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)
  api_tokens_v2 api_tokens_v2 @relation(fields: [selector], references: [selector], onDelete: Cascade, onUpdate: NoAction)

  @@id([selector, project])
}

model banners {
  id           Int      @id(map: "message_banners_pkey") @default(autoincrement())
  enabled      Boolean  @default(true)
  message      String
  variant      String?
  sticky       Boolean? @default(false)
  icon         String?
  link         String?
  link_text    String?
  dialog_title String?
  dialog       String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
}

model cdn_tokens {
  id          String    @id
  token_name  String
  project     String
  environment String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  expires_at  DateTime? @db.Timestamptz(6)
  seen_at     DateTime? @db.Timestamptz(6)
}

model change_request_approvals {
  id                Int             @id @default(autoincrement())
  change_request_id Int
  created_by        Int
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  change_requests   change_requests @relation(fields: [change_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users           @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([change_request_id, created_by], map: "unique_approvals")
}

model change_request_comments {
  id              Int             @id @default(autoincrement())
  change_request  Int
  text            String
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  created_by      Int
  change_requests change_requests @relation(fields: [change_request], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users           @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model change_request_events {
  id                Int             @id @default(autoincrement())
  feature           String?         @db.VarChar(255)
  action            String          @db.VarChar(255)
  payload           Json            @default("[]")
  created_by        Int
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  change_request_id Int
  change_requests   change_requests @relation(fields: [change_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users           @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  features          features?       @relation(fields: [feature], references: [name], onDelete: Cascade, onUpdate: NoAction)
}

model change_request_rejections {
  id                Int             @id @default(autoincrement())
  change_request_id Int
  created_by        Int
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  change_requests   change_requests @relation(fields: [change_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users           @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([change_request_id, created_by])
}

model change_request_requested_approvers {
  change_request_id Int
  user_id           Int
  requested_at      DateTime?       @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  notified_at       DateTime?       @db.Timestamptz(6)
  change_requests   change_requests @relation(fields: [change_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([change_request_id, user_id])
  @@index([change_request_id], map: "change_request_requested_approvers_cr_id_idx")
  @@index([user_id])
  @@index([notified_at], map: "cr_req_approvers_notified_at_idx")
}

model change_request_schedule {
  change_request  Int             @id
  scheduled_at    DateTime        @db.Timestamp(6)
  created_by      Int?
  status          String?
  failure_reason  String?
  reason          String?
  change_requests change_requests @relation(fields: [change_request], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model change_request_settings {
  project            String       @db.VarChar(255)
  environment        String       @db.VarChar(100)
  required_approvals Int?         @default(1)
  environments       environments @relation(fields: [environment], references: [name], onDelete: Cascade, onUpdate: NoAction)
  projects           projects     @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project, environment])
  @@unique([project, environment])
}

model change_requests {
  id                                 Int                                  @id @default(autoincrement())
  environment                        String?                              @db.VarChar(100)
  state                              String                               @db.VarChar(255)
  project                            String?                              @db.VarChar(255)
  created_by                         Int
  created_at                         DateTime?                            @default(now()) @db.Timestamptz(6)
  min_approvals                      Int?                                 @default(1)
  title                              String?
  change_request_approvals           change_request_approvals[]
  change_request_comments            change_request_comments[]
  change_request_events              change_request_events[]
  change_request_rejections          change_request_rejections[]
  change_request_requested_approvers change_request_requested_approvers[]
  change_request_schedule            change_request_schedule?
  users                              users                                @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  environments                       environments?                        @relation(fields: [environment], references: [name], onDelete: Cascade, onUpdate: NoAction)
  projects                           projects?                            @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)
  servicenow_change_references       servicenow_change_references[]

  @@unique([created_by, project, environment], map: "unique_pending_request_per_user_project_env", where: raw("((state)::text <> ALL ((ARRAY['Applied'::character varying, 'Cancelled'::character varying, 'Rejected'::character varying, 'Scheduled'::character varying])::text[]))"))
}

model client_applications {
  app_name                  String                      @id @db.VarChar(255)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  seen_at                   DateTime?                   @db.Timestamptz(6)
  strategies                Json?                       @db.Json
  description               String?                     @db.VarChar(255)
  icon                      String?                     @db.VarChar(255)
  url                       String?                     @db.VarChar(255)
  color                     String?                     @db.VarChar(255)
  announced                 Boolean?                    @default(false)
  created_by                String?
  client_applications_usage client_applications_usage[]

  @@index([announced], map: "idx_client_applications_announced_false", where: raw("(announced = false)"))
}

model client_applications_usage {
  app_name            String              @db.VarChar(255)
  project             String              @db.VarChar(255)
  environment         String              @db.VarChar(100)
  client_applications client_applications @relation(fields: [app_name], references: [app_name], onDelete: Cascade, onUpdate: NoAction)

  @@id([app_name, project, environment])
}

model client_instances {
  app_name    String    @db.VarChar(255)
  instance_id String    @db.VarChar(255)
  client_ip   String?   @db.VarChar(255)
  last_seen   DateTime? @default(now()) @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  sdk_version String?   @db.VarChar(255)
  environment String    @default("default") @db.VarChar(255)
  sdk_type    String?   @db.VarChar(255)

  @@id([app_name, environment, instance_id])
  @@index([environment])
}

model client_metrics_env {
  feature_name                String                        @db.VarChar(255)
  app_name                    String                        @db.VarChar(255)
  environment                 String                        @db.VarChar(100)
  timestamp                   DateTime                      @db.Timestamptz(6)
  yes                         BigInt?                       @default(0)
  no                          BigInt?                       @default(0)
  client_metrics_env_variants client_metrics_env_variants[]

  @@id([feature_name, app_name, environment, timestamp])
  @@index([feature_name], map: "idx_client_metrics_f_name")
}

model client_metrics_env_daily {
  feature_name                      String                              @db.VarChar(255)
  app_name                          String                              @db.VarChar(255)
  environment                       String                              @db.VarChar(100)
  date                              DateTime                            @db.Date
  yes                               BigInt?                             @default(0)
  no                                BigInt?                             @default(0)
  client_metrics_env_variants_daily client_metrics_env_variants_daily[]

  @@id([feature_name, app_name, environment, date])
}

model client_metrics_env_variants {
  feature_name       String             @db.VarChar(255)
  app_name           String             @db.VarChar(255)
  environment        String             @db.VarChar(100)
  timestamp          DateTime           @db.Timestamptz(6)
  variant            String
  count              Int?               @default(0)
  client_metrics_env client_metrics_env @relation(fields: [feature_name, app_name, environment, timestamp], references: [feature_name, app_name, environment, timestamp], onDelete: Cascade)

  @@id([feature_name, app_name, environment, timestamp, variant])
}

model client_metrics_env_variants_daily {
  feature_name             String                   @db.VarChar(255)
  app_name                 String                   @db.VarChar(255)
  environment              String                   @db.VarChar(100)
  date                     DateTime                 @db.Date
  variant                  String
  count                    BigInt?                  @default(0)
  client_metrics_env_daily client_metrics_env_daily @relation(fields: [feature_name, app_name, environment, date], references: [feature_name, app_name, environment, date], onDelete: Cascade, map: "client_metrics_env_variants_d_feature_name_app_name_enviro_fkey")

  @@id([feature_name, app_name, environment, date, variant])
}

model connection_count_consumption {
  day           DateTime @db.Date
  metered_group String
  requests      BigInt   @default(0)
  connections   Float    @default(0)
  origin        String   @default("sdk")

  @@id([day, metered_group, origin])
}

model context_fields {
  name         String    @id @db.VarChar(255)
  description  String?
  sort_order   Int?      @default(10)
  legal_values Json?     @db.Json
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  stickiness   Boolean?  @default(false)
  project      String?   @db.VarChar(255)
  projects     projects? @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model dependent_features {
  parent                                       String   @db.VarChar(255)
  child                                        String   @db.VarChar(255)
  enabled                                      Boolean  @default(true)
  variants                                     Json     @default("[]")
  features_dependent_features_childTofeatures  features @relation("dependent_features_childTofeatures", fields: [child], references: [name], onDelete: Cascade, onUpdate: NoAction)
  features_dependent_features_parentTofeatures features @relation("dependent_features_parentTofeatures", fields: [parent], references: [name], onUpdate: NoAction)

  @@id([parent, child])
}

model edge_api_tokens {
  id                String            @id
  client_id         String
  environment       String
  projects          Json
  scope_hash        String
  token_value       String
  created_at        DateTime          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  revoked_at        DateTime?         @db.Timestamptz(6)
  edge_hmac_clients edge_hmac_clients @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  api_tokens        api_tokens        @relation(fields: [token_value], references: [secret], onDelete: NoAction, onUpdate: NoAction)

  @@unique([client_id, scope_hash], map: "edge_api_token_scope_uniq_idx", where: raw("(revoked_at IS NULL)"))
  @@index([token_value])
}

model edge_hmac_clients {
  id               String             @id
  secret_enc       Bytes
  status           String             @default("active")
  created_at       DateTime           @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  edge_api_tokens  edge_api_tokens[]
  edge_hmac_nonces edge_hmac_nonces[]
}

model edge_hmac_nonces {
  client_id         String
  nonce             String
  expires_at        DateTime          @db.Timestamptz(6)
  edge_hmac_clients edge_hmac_clients @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([client_id, nonce])
  @@index([client_id])
  @@index([nonce])
}

model edge_node_presence {
  bucket_ts     DateTime @db.Timestamptz(6)
  node_ephem_id String

  @@id([bucket_ts, node_ephem_id])
  @@index([bucket_ts], map: "edge_node_presence_brin", type: Brin)
  @@index([node_ephem_id], map: "edge_node_presence_node_hash", type: Hash)
}

model emails_sent {
  id         String    @db.VarChar(255)
  type       String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  payload    Json      @default("{}")

  @@id([id, type])
}

model environment_type_trends {
  id               String    @db.VarChar(255)
  environment_type String    @db.VarChar(255)
  total_updates    Int
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@id([id, environment_type])
}

model environments {
  name                           String                           @id @db.VarChar(100)
  created_at                     DateTime?                        @default(now()) @db.Timestamptz(6)
  sort_order                     Int?                             @default(9999)
  type                           String
  enabled                        Boolean?                         @default(true)
  protected                      Boolean?                         @default(false)
  required_approvals             Int?
  api_tokens_v2                  api_tokens_v2[]
  change_request_settings        change_request_settings[]
  change_requests                change_requests[]
  feature_environment_safeguards feature_environment_safeguards[]
  feature_environments           feature_environments[]
  feature_strategies             feature_strategies[]
  project_environments           project_environments[]
  release_plan_definitions       release_plan_definitions[]
  release_plan_safeguards        release_plan_safeguards[]
  role_permission                role_permission[]
}

model events {
  id                 Int             @id @default(autoincrement())
  created_at         DateTime?       @default(now()) @db.Timestamptz(6)
  type               String          @db.VarChar(255)
  created_by         String          @db.VarChar(255)
  data               Json?           @db.Json
  tags               Json?           @default("[]") @db.Json
  project            String?
  environment        String?
  feature_name       String?
  pre_data           Json?
  announced          Boolean         @default(false)
  created_by_user_id Int?
  ip                 String?
  group_type         String?
  group_id           String?
  notifications      notifications[]

  @@index([created_by_user_id])
  @@index([environment])
  @@index([project])
  @@index([announced], map: "events_unannounced_idx", where: raw("(announced = false)"))
  @@index([feature_name], map: "feature_name_idx")
  @@index([created_at(sort: Desc)], map: "idx_events_created_at_desc")
  @@index([id], map: "idx_events_feature_type_id", where: raw("((feature_name IS NOT NULL) OR ((type)::text = ANY ((ARRAY['segment-updated'::character varying, 'feature_import'::character varying, 'features-imported'::character varying])::text[])))"))
  @@index([project, feature_name, created_at(sort: Desc)], map: "idx_events_project_feature_created")
  @@index([type], map: "idx_events_type")
}

model favorite_features {
  feature    String   @db.VarChar(255)
  user_id    Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  features   features @relation(fields: [feature], references: [name], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([feature, user_id])
}

model favorite_projects {
  project    String   @db.VarChar(255)
  user_id    Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  projects   projects @relation(fields: [project], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project, user_id])
}

model feature_environment_safeguards {
  id                String         @id
  impact_metric_id  String
  trigger_condition Json
  environment       String
  feature_name      String
  environments      environments   @relation(fields: [environment], references: [name], onDelete: Cascade, onUpdate: NoAction)
  features          features       @relation(fields: [feature_name], references: [name], onDelete: Cascade, onUpdate: NoAction)
  impact_metrics    impact_metrics @relation(fields: [impact_metric_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model feature_environments {
  environment  String       @default("default") @db.VarChar(100)
  feature_name String       @db.VarChar(255)
  enabled      Boolean
  variants     Json         @default("[]")
  last_seen_at DateTime?    @db.Timestamptz(6)
  environments environments @relation(fields: [environment], references: [name], onDelete: Cascade, onUpdate: NoAction)
  features     features     @relation(fields: [feature_name], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@id([environment, feature_name])
  @@index([feature_name])
}

model feature_lifecycles {
  feature      String    @db.VarChar(255)
  stage        String    @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  status       String?
  status_value String?
  features     features  @relation(fields: [feature], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@id([feature, stage])
}

model feature_link {
  id           String   @id
  feature_name String   @db.VarChar(255)
  url          String
  title        String?
  domain       String?  @db.VarChar(255)
  features     features @relation(fields: [feature_name], references: [name], onDelete: Cascade, onUpdate: NoAction)
}

model feature_strategies {
  id                       String                     @id
  feature_name             String                     @db.VarChar(255)
  project_name             String                     @db.VarChar(255)
  environment              String                     @default("default") @db.VarChar(100)
  strategy_name            String                     @db.VarChar(255)
  parameters               Json                       @default("{}")
  constraints              Json                       @default("[]")
  sort_order               Int                        @default(9999)
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  title                    String?
  disabled                 Boolean?                   @default(false)
  variants                 Json                       @default("[]")
  created_by_user_id       Int?
  milestone_id             String?
  environments             environments               @relation(fields: [environment], references: [name], onDelete: Cascade, onUpdate: NoAction)
  features                 features                   @relation(fields: [feature_name], references: [name], onDelete: Cascade, onUpdate: NoAction)
  milestones               milestones?                @relation(fields: [milestone_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feature_strategy_segment feature_strategy_segment[]

  @@index([environment])
  @@index([feature_name])
  @@index([milestone_id], map: "idx_feature_strategies_milestone_id", where: raw("(milestone_id IS NOT NULL)"))
}

model feature_strategy_segment {
  feature_strategy_id String
  segment_id          Int
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  feature_strategies  feature_strategies @relation(fields: [feature_strategy_id], references: [id], onDelete: Cascade)
  segments            segments           @relation(fields: [segment_id], references: [id], onDelete: Cascade)

  @@id([feature_strategy_id, segment_id])
  @@index([segment_id], map: "feature_strategy_segment_segment_id_index")
}

model feature_tag {
  feature_name       String    @db.VarChar(255)
  tag_type           String
  tag_value          String
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  created_by_user_id Int?
  features           features  @relation(fields: [feature_name], references: [name], onDelete: Cascade, onUpdate: NoAction)
  tags               tags      @relation(fields: [tag_type, tag_value], references: [type, value], onDelete: Cascade, onUpdate: NoAction)

  @@id([feature_name, tag_type, tag_value])
  @@index([tag_type, tag_value], map: "feature_tag_tag_type_and_value_idx")
}

model feature_types {
  id                 String             @id @db.VarChar(255)
  name               String             @db.VarChar
  description        String?            @db.VarChar
  lifetime_days      Int?
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  created_by_user_id Int?
  lifecycle_trends   lifecycle_trends[]
}

model features {
  created_at                                             DateTime?                        @default(now()) @db.Timestamptz(6)
  name                                                   String                           @id @db.VarChar(255)
  description                                            String?
  variants                                               Json?                            @default("[]") @db.Json
  type                                                   String?                          @default("release") @db.VarChar
  stale                                                  Boolean?                         @default(false)
