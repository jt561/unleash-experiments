  upstream_features_p99_latency_ms     Decimal? @default(0.0) @db.Decimal
  upstream_metrics_average_latency_ms  Decimal? @default(0.0) @db.Decimal
  upstream_metrics_p99_latency_ms      Decimal? @default(0.0) @db.Decimal
  upstream_edge_average_latency_ms     Decimal? @default(0.0) @db.Decimal
  upstream_edge_p99_latency_ms         Decimal? @default(0.0) @db.Decimal
  hosting                              String?
  api_key_revision_ids                 Json?

  @@index([app_name], map: "edge_observability_app_name_idx", where: raw("(app_name IS NOT NULL)"))
  @@index([connected_via], map: "edge_observability_connected_via_idx", where: raw("(connected_via IS NOT NULL)"))
}

model stat_edge_traffic_usage {
  instance_id   String
  day           DateTime @db.Date
  traffic_group String
  count         BigInt   @default(0)
  status_code   Int      @default(200)

  @@id([instance_id, traffic_group, day, status_code])
  @@index([day])
  @@index([traffic_group])
  @@index([status_code, traffic_group], map: "stat_edge_traffic_usage_traffic_group_status_code_idx")
}

model stat_environment_updates {
  day         DateTime @db.Date
  environment String
  updates     BigInt   @default(0)

  @@id([day, environment])
}

model stat_traffic_usage {
  day                DateTime @db.Date
  traffic_group      String
  status_code_series Int
  count              BigInt   @default(0)

  @@id([day, traffic_group, status_code_series])
  @@index([day])
  @@index([status_code_series])
  @@index([traffic_group])
}

model strategies {
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  name                 String                 @id @db.VarChar(255)
  description          String?
  parameters           Json?                  @db.Json
  built_in             Int?                   @default(0)
  deprecated           Boolean?               @default(false)
  sort_order           Int?                   @default(9999)
  display_name         String?
  title                String?
  milestone_strategies milestone_strategies[]
}

model tag_types {
  name        String    @id
  description String?
  icon        String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  color       String?   @db.VarChar(10)
  tags        tags[]
}

model tags {
  type        String
  value       String
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  feature_tag feature_tag[]
  tag_types   tag_types     @relation(fields: [type], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@id([type, value])
}

model unique_connections {
  id         String    @id @db.VarChar(255)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  hll        Bytes
}

model unknown_flags {
  name        String
  app_name    String
  seen_at     DateTime @default(now()) @db.Timestamptz(6)
  environment String   @default("default")

  @@id([name, app_name, environment])
}

model unleash_session {
  sid        String    @id @db.VarChar
  sess       Json      @db.Json
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expired    DateTime  @db.Timestamptz(6)

  @@index([expired], map: "idx_unleash_session_expired")
}

model used_passwords {
  user_id       Int
  password_hash String
  used_at       DateTime? @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, password_hash])
  @@index([password_hash], map: "used_passwords_pw_hash_idx")
}

model user_access_requests {
  id           String   @id
  email        String   @unique
  requested_at DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
}

model user_feedback {
  user_id     Int
  feedback_id String
  given       DateTime? @db.Timestamptz(6)
  nevershow   Boolean   @default(false)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, feedback_id])
  @@index([user_id])
}

model user_notifications {
  notification_id Int
  user_id         Int
  read_at         DateTime?     @db.Timestamptz(6)
  notifications   notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([notification_id, user_id])
}

model user_splash {
  user_id   Int
  splash_id String
  seen      Boolean @default(false)
  users     users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, splash_id])
  @@index([user_id])
}

model user_trends {
  id           String    @id @db.VarChar(255)
  total_users  Int
  active_users Int
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model user_unsubscription {
  user_id      Int
  subscription String    @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, subscription])
}

model users {
  id                                 Int                                  @id @default(autoincrement())
  name                               String?                              @db.VarChar(255)
  username                           String?                              @unique @db.VarChar(255)
  email                              String?                              @unique @db.VarChar(255)
  image_url                          String?
  password_hash                      String?                              @db.VarChar(255)
  login_attempts                     Int?                                 @default(0)
  created_at                         DateTime?                            @default(now()) @db.Timestamp(6)
  seen_at                            DateTime?                            @db.Timestamp(6)
  settings                           Json?                                @db.Json
  permissions                        Json?                                @default("[]") @db.Json
  deleted_at                         DateTime?                            @db.Timestamptz(6)
  is_service                         Boolean?                             @default(false)
  created_by_user_id                 Int?
  is_system                          Boolean                              @default(false)
  scim_id                            String?                              @unique(map: "users_scim_id_unique_idx", where: raw("(scim_id IS NOT NULL)"))
  scim_external_id                   String?                              @unique(map: "users_scim_external_id_uniq_idx", where: raw("(scim_external_id IS NOT NULL)"))
  first_seen_at                      DateTime?                            @db.Timestamp(6)
  email_hash                         String?
  updated_at                         DateTime                             @default(now()) @db.Timestamptz(6)
  seat_type                          String?
  company_role                       String?
  product_updates_email_consent      Boolean?
  change_request_approvals           change_request_approvals[]
  change_request_comments            change_request_comments[]
  change_request_events              change_request_events[]
  change_request_rejections          change_request_rejections[]
  change_request_requested_approvers change_request_requested_approvers[]
  change_request_schedule            change_request_schedule[]
  change_requests                    change_requests[]
  favorite_features                  favorite_features[]
  favorite_projects                  favorite_projects[]
  group_user                         group_user[]
  personal_access_tokens             personal_access_tokens[]
  public_signup_tokens_user          public_signup_tokens_user[]
  reset_tokens                       reset_tokens[]
  role_user                          role_user[]
  used_passwords                     used_passwords[]
  user_feedback                      user_feedback[]
  user_notifications                 user_notifications[]
  user_splash                        user_splash[]
  user_unsubscription                user_unsubscription[]

  @@index([updated_at(sort: Desc)], map: "idx_users_only_updated_at_desc", where: raw("((is_system = false) AND (is_service = false))"))
  @@index([email_hash])
}
